<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0E0E0E">

    <!-- LEFT SIDEBAR - Same ID rakha hai -->
    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#151515"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AS\nAALAM STUDIO"
            android:textColor="#FFC121"
            android:textStyle="bold"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="24dp" />

        <TextView style="@style/SidebarItem" android:text="🏠  Home" android:textColor="#888888" />
        <TextView style="@style/SidebarItem" android:text="📁  Projects" android:textColor="#888888" />
        <TextView style="@style/SidebarItem" android:text="⊞  Templates" android:textColor="#888888" />
        <TextView style="@style/SidebarItem" android:text="📦  Assets" android:textColor="#888888" />
        <TextView style="@style/SidebarItem" android:text="📖  Tutorials" android:textColor="#888888" />
        <TextView style="@style/SidebarItem" android:text="👥  Community" android:textColor="#888888" />
        <TextView style="@style/SidebarItem" android:text="🛠  Tools" android:textColor="#888888" />
        <TextView
            android:id="@+id/settingsNavItem"
            style="@style/SidebarItem"
            android:text="⚙  Settings"
            android:textColor="#888888" />
    </LinearLayout>

    <!-- CENTER -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- HEADER - Same ID btnBack rakha hai -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_dark"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Build APK"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Build and export your application"
                        android:textColor="#777777"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- APP INFO - IDs: tvAppName, tvPackageVersion same rakha hai -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_gold_border"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_app_icon"
                    android:src="@android:drawable/ic_menu_sort_by_size" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvAppName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Finance Hub"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  APP" android:textColor="#FFC121" android:textSize="9sp" android:background="@drawable/bg_badge_dark" android:padding="4dp" android:layout_marginStart="8dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPackageVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="com.aalamstudio.financehub • Version 1.0.0 (1)"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- BUILDING CARD - IDs: progressRing, tvPercent, tvStatus etc same -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_gold_border"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp">

                        <com.aalamstudio.compiler.CircularProgressView
                            android:id="@+id/progressRing"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/tvPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="78%"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Building APK..."
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSubStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Compiling resources and optimizing your app"
                            android:textColor="#888888"
                            android:textSize="10sp" />

                        <ProgressBar
                            android:id="@+id/progressLinear"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="10dp"
                            android:max="100"
                            android:progress="78"
                            android:progressDrawable="@drawable/progress_gold_linear" />

                        <TextView
                            android:id="@+id/tvTimeRemaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7m 24s remaining"
                            android:textColor="#AAAAAA"
                            android:textSize="10sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 7 STEPS - IDs step1 to step7 same rakha hai -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:weightSum="7">

                    <LinearLayout android:id="@+id/step1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/step_done" android:text="✓" android:textColor="#000" android:gravity="center" android:textSize="10sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Preparing&#10;Project" android:textColor="#888" android:textSize="8sp" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/step2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/step_done" android:text="✓" android:textColor="#000" android:gravity="center" android:textSize="10sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Compiling&#10;Code" android:textColor="#888" android:textSize="8sp" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/step3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/step_active" android:text="3" android:textColor="#000" android:gravity="center" android:textSize="10sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Processing&#10;Resources" android:textColor="#FFC121" android:textSize="8sp" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/step4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/step_pending" android:text="4" android:textColor="#FFF" android:gravity="center" android:textSize="9sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Optimizing" android:textColor="#555" android:textSize="8sp" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/step5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/step_pending" android:text="5" android:textColor="#FFF" android:gravity="center" android:textSize="9sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Packaging" android:textColor="#555" android:textSize="8sp" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/step6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/step_pending" android:text="6" android:textColor="#FFF" android:gravity="center" android:textSize="9sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Signing" android:textColor="#555" android:textSize="8sp" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/step7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/step_pending" android:text="7" android:textColor="#FFF" android:gravity="center" android:textSize="9sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Completed" android:textColor="#555" android:textSize="8sp" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- BUILD LOG - ID rvBuildLog same hai -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_gold_border"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Build Log" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp" />
                    <Button android:id="@+id/btnClearLog" android:layout_width="wrap_content" android:layout_height="28dp" android:text="Clear Log" android:textSize="9sp" android:backgroundTint="#252525" android:textColor="#AAA"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBuildLog"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="#101010"
                    android:padding="8dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- BOTTOM INFO -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:id="@+id/tvBuildStarted" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Build Started\nMay 20, 2025 10:24 AM" android:textColor="#888" android:textSize="9sp" android:background="#1A1A1A" android:padding="8dp"/>
                <TextView android:id="@+id/tvEstimatedTime" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Estimated Time\n~ 9m 24s" android:textColor="#888" android:textSize="9sp" android:background="#1A1A1A" android:padding="8dp" android:layout_marginStart="6dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <Button android:id="@+id/btnCancelBuild" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Cancel Build" android:textSize="10sp" android:textColor="#FF5C5C" android:backgroundTint="#2A1A1A"/>
                <Button android:id="@+id/btnRunBackground" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Run in Background" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#252525" android:layout_marginStart="6dp"/>
                <Button android:id="@+id/btnBuildBackground" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Build in Background" android:textSize="10sp" android:textColor="#000000" android:backgroundTint="#FFC121" android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- RIGHT PANEL - IDs btnDebug, btnRelease, tvMinSdk same rakha hai -->
    <ScrollView android:layout_width="200dp" android:layout_height="match_parent" android:background="#151515">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙ Build Configuration" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:layout_marginBottom="12dp"/>
            <TextView style="@style/ConfigLabel" android:text="Build Type"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <Button android:id="@+id/btnDebug" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="Debug" android:textSize="9sp" android:backgroundTint="#1A1A1A" android:textColor="#FFF"/>
                <Button android:id="@+id/btnRelease" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:text="Release" android:textSize="9sp" android:backgroundTint="#FFC121" android:textColor="#000" android:layout_marginStart="6dp"/>
            </LinearLayout>
            <TextView style="@style/ConfigLabel" android:text="Target Platform"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🤖 Android" android:textColor="#FFC121" android:textSize="10sp" android:background="@drawable/bg_btn_gold_border" android:padding="8dp" android:layout_marginBottom="12dp"/>
            <TextView style="@style/ConfigLabel" android:text="Min SDK"/>
            <TextView android:id="@+id/tvMinSdk" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Android 7.0 (API 24)" android:textColor="#FFF" android:textSize="10sp" android:background="#1A1A1A" android:padding="8dp" android:layout_marginBottom="10dp"/>
            <TextView style="@style/ConfigLabel" android:text="Target SDK"/>
            <TextView android:id="@+id/tvTargetSdk" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Android 14 (API 34)" android:textColor="#FFF" android:textSize="10sp" android:background="#1A1A1A" android:padding="8dp" android:layout_marginBottom="10dp"/>
            <TextView style="@style/ConfigLabel" android:text="Build Variant"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="arm64-v8a (Recommended)" android:textColor="#FFF" android:textSize="10sp" android:background="#1A1A1A" android:padding="8dp" android:layout_marginBottom="10dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
