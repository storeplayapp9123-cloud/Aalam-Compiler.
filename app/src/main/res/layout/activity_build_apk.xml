<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_root">

    <!-- ================= LEFT SIDEBAR ================= -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_sidebar"
        android:paddingTop="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AS"
            android:textColor="@color/amber"
            android:textSize="34sp"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="AALAM COMPILER"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BUILD. COMPILE. SHIP."
            android:textColor="@color/amber_dark"
            android:textSize="8sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="24dp" />

        <!-- Nav items (only what Aalam Compiler actually has) -->
        <TextView
            android:id="@+id/navHome"
            style="@style/SidebarNavItem"
            android:text="  Home"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/navBuildApk"
            style="@style/SidebarNavItem"
            android:text="  Build APK"
            android:background="@drawable/bg_pill_selected_amber"
            android:textColor="@color/amber"/>

        <TextView
            android:id="@+id/navSettings"
            style="@style/SidebarNavItem"
            android:text="  Settings"
            android:textColor="@color/text_secondary"/>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- User card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="10dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_step_circle_active"
                android:gravity="center"
                android:text="A"
                android:textColor="#000000"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aalam Creator"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pro Plan"
                    android:textColor="@color/amber"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= MAIN CONTENT ================= -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/text_primary"
                android:textSize="18sp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Build APK"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Build and export your application"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_outline"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="❓  Help"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- App info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_step_circle_active"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Finance Hub"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_unselected"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="APP"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="com.aalamstudio.financehub  •  Version 1.0.0 (1)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Middle: center column + right panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- CENTER COLUMN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">

                <!-- Progress card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="110dp"
                            android:layout_height="110dp">

                            <com.aalamstudio.compiler.ui.CircularProgressView
                                android:id="@+id/progressRing"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>

                            <TextView
                                android:id="@+id/tvPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="78%"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="24sp"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="20dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Building APK..."
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="17sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Compiling resources and optimizing your app"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginBottom="10dp"/>

                            <ProgressBar
                                android:id="@+id/linearProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:progressTint="@color/amber"
                                android:progressBackgroundTint="@color/border_subtle"
                                android:progress="78"
                                android:max="100"/>

                            <TextView
                                android:id="@+id/tvTimeRemaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="7m 24s remaining"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step indicator -->
                    <LinearLayout
                        android:id="@+id/stepIndicatorContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical">
                        <!-- Populate 7 step views programmatically, OR use the
                             repeated block below as a static reference layout -->

                        <!-- Step 1: done -->
                        <include layout="@layout/step_item_done" />
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="@color/amber"/>
                        <!-- Step 2: done -->
                        <include layout="@layout/step_item_done" />
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="@color/amber"/>
                        <!-- Step 3: active -->
                        <include layout="@layout/step_item_active" />
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="@color/border_subtle"/>

                        <!-- Step 4: pending -->
                        <LinearLayout style="@style/StepPendingWrap">
                            <TextView style="@style/StepCirclePending" android:text="4"/>
                            <TextView style="@style/StepLabelPending" android:text="Optimizing"/>
                        </LinearLayout>
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="@color/border_subtle"/>

                        <!-- Step 5: pending -->
                        <LinearLayout style="@style/StepPendingWrap">
                            <TextView style="@style/StepCirclePending" android:text="5"/>
                            <TextView style="@style/StepLabelPending" android:text="Packaging"/>
                        </LinearLayout>
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="@color/border_subtle"/>

                        <!-- Step 6: pending -->
                        <LinearLayout style="@style/StepPendingWrap">
                            <TextView style="@style/StepCirclePending" android:text="6"/>
                            <TextView style="@style/StepLabelPending" android:text="Signing"/>
                        </LinearLayout>
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="@color/border_subtle"/>

                        <!-- Step 7: pending -->
                        <LinearLayout style="@style/StepPendingWrap">
                            <TextView style="@style/StepCirclePending" android:text="7"/>
                            <TextView style="@style/StepLabelPending" android:text="Completed"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Build log card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Build Log"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_button_outline"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="🗑  Clear Log"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBuildLog"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scrollbars="vertical"/>
                </LinearLayout>

                <!-- Bottom info row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="14dp"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📅  Build Started\nMay 20, 2025 10:24 AM"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🕐  Estimated Time\n~ 9m 24s"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚙️  Configuration\nRelease Build • Android"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Action buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_danger_outline"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="✕  Cancel Build"
                        android:textColor="@color/red_danger"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_button_outline"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="⤢  Run in Background"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:background="@drawable/bg_button_amber"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="▷  Build in Background"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- RIGHT PANEL -->
            <ScrollView
                android:layout_width="300dp"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Build Configuration card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚙️  Build Configuration"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginBottom="14dp"/>

                        <TextView style="@style/FieldLabel" android:text="Build Type"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="14dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_pill_unselected"
                                android:gravity="center"
                                android:padding="10dp"
                                android:text="⬡  Debug"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_pill_selected_amber"
                                android:gravity="center"
                                android:padding="10dp"
                                android:text="🔒  Release"
                                android:textColor="@color/amber"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <TextView style="@style/FieldLabel" android:text="Target Platform"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="14dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_pill_selected_green"
                                android:gravity="center"
                                android:padding="10dp"
                                android:text="🤖  Android"
                                android:textColor="@color/android_green"
                                android:textSize="12sp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_pill_unselected"
                                android:gravity="center"
                                android:padding="10dp"
                                android:text="⊞  Universal"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <TextView style="@style/FieldLabel" android:text="Min SDK"/>
                        <TextView style="@style/DropdownField" android:text="Android 7.0 (API 24)  ⌄"/>

                        <TextView style="@style/FieldLabel" android:text="Target SDK"/>
                        <TextView style="@style/DropdownField" android:text="Android 14 (API 34)  ⌄"/>

                        <TextView style="@style/FieldLabel" android:text="Build Variant"/>
                        <TextView style="@style/DropdownField" android:text="arm64-v8a (Recommended)  ⌄"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="⚙️  Advanced Settings  ⌄"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Output card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Output"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginBottom="14dp"/>

                        <TextView style="@style/FieldLabel" android:text="Output Path"/>
                        <TextView style="@style/DropdownField" android:text="📁 /storage/emulated/0/Aalam Studio/Builds"/>

                        <TextView style="@style/FieldLabel" android:text="File Name"/>
                        <TextView style="@style/DropdownField" android:text="FinanceHub_v1.0.0_release.apk"/>

                        <TextView style="@style/FieldLabel" android:text="Expected Size"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="42.6 MB (approx.)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="14dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Build Output (Will be available)"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:layout_marginBottom="8dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_pill_unselected"
                            android:padding="10dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="📦  FinanceHub_v1.0.0_release.apk\nAPK File"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="42.6 MB ⬇"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
