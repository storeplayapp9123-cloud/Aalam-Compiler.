<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0D0D0D">

    <!-- LEFT SIDEBAR -->
    <LinearLayout
        android:layout_width="130dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#151515"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AALAM STUDIO"
            android:textColor="#F5A623"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <TextView style="@style/SidebarItem" android:text="Home" />
        <TextView style="@style/SidebarItem" android:text="Projects" />
        <TextView style="@style/SidebarItem" android:text="Templates" />
        <TextView style="@style/SidebarItem" android:text="Assets" />
        <TextView style="@style/SidebarItem" android:text="Tools" />
        <TextView
            android:id="@+id/settingsNavItem"
            style="@style/SidebarItem"
            android:text="Settings" />
    </LinearLayout>

    <!-- CENTER COLUMN -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Build APK"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Build and export your application"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- APP INFO ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#151515"
                android:padding="10dp"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#F5A623" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:id="@+id/tvAppName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aalam Compiler"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPackageVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="com.aalamstudio.compiler • v1.0.0"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- PROGRESS RING + STATUS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp">

                    <com.aalamstudio.compiler.CircularProgressView
                        android:id="@+id/progressRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tvPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="0%"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Building APK..."
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Compiling resources and optimizing your app"
                        android:textColor="#888888"
                        android:textSize="10sp" />

                    <ProgressBar
                        android:id="@+id/progressLinear"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:progressTint="#F5A623"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tvTimeRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculating time..."
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 7-STEP INDICATOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="14dp">

                <LinearLayout android:id="@+id/step1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/step_circle_pending" android:text="1" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prep" android:textColor="#888888" android:textSize="8sp" />
                </LinearLayout>

                <View android:layout_width="10dp" android:layout_height="1dp" android:background="#2A2A2A" />

                <LinearLayout android:id="@+id/step2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/step_circle_pending" android:text="2" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Compile" android:textColor="#888888" android:textSize="8sp" />
                </LinearLayout>

                <View android:layout_width="10dp" android:layout_height="1dp" android:background="#2A2A2A" />

                <LinearLayout android:id="@+id/step3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/step_circle_pending" android:text="3" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Process" android:textColor="#888888" android:textSize="8sp" />
                </LinearLayout>

                <View android:layout_width="10dp" android:layout_height="1dp" android:background="#2A2A2A" />

                <LinearLayout android:id="@+id/step4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/step_circle_pending" android:text="4" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Optimize" android:textColor="#888888" android:textSize="8sp" />
                </LinearLayout>

                <View android:layout_width="10dp" android:layout_height="1dp" android:background="#2A2A2A" />

                <LinearLayout android:id="@+id/step5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/step_circle_pending" android:text="5" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Package" android:textColor="#888888" android:textSize="8sp" />
                </LinearLayout>

                <View android:layout_width="10dp" android:layout_height="1dp" android:background="#2A2A2A" />

                <LinearLayout android:id="@+id/step6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/step_circle_pending" android:text="6" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sign" android:textColor="#888888" android:textSize="8sp" />
                </LinearLayout>

                <View android:layout_width="10dp" android:layout_height="1dp" android:background="#2A2A2A" />

                <LinearLayout android:id="@+id/step7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/step_circle_pending" android:text="7" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Done" android:textColor="#888888" android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- BUILD LOG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Build Log"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textSize="9sp"
                    android:backgroundTint="#1A1A1A"
                    android:textColor="#CCCCCC" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBuildLog"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="#151515"
                android:padding="6dp"
                android:layout_marginBottom="12dp" />

            <!-- BOTTOM INFO + BUTTONS -->
            <TextView
                android:id="@+id/tvBuildStarted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Build Started: --"
                android:textColor="#888888"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tvEstimatedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estimated Time: --"
                android:textColor="#888888"
                android:textSize="9sp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelBuild"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textSize="10sp"
                    android:textColor="#FF5C5C"
                    android:backgroundTint="#1A1A1A" />

                <Button
                    android:id="@+id/btnRunBackground"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Run in BG"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1A1A1A" />

                <Button
                    android:id="@+id/btnBuildBackground"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Build BG"
                    android:textSize="10sp"
                    android:textColor="#000000"
                    android:backgroundTint="#F5A623" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- RIGHT PANEL -->
    <ScrollView
        android:layout_width="170dp"
        android:layout_height="match_parent"
        android:background="#151515">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Build Configuration"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <TextView style="@style/ConfigLabel" android:text="Build Type" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnDebug"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Debug"
                    android:textSize="9sp"
                    android:backgroundTint="#1A1A1A"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnRelease"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Release"
                    android:textSize="9sp"
                    android:backgroundTint="#F5A623"
                    android:textColor="#000000" />
            </LinearLayout>

            <TextView style="@style/ConfigLabel" android:text="Min SDK" />
            <TextView android:id="@+id/tvMinSdk" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Android 7.0 (API 24)" android:textColor="#FFFFFF" android:textSize="10sp" android:background="#1A1A1A" android:padding="6dp" android:layout_marginBottom="10dp" />

            <TextView style="@style/ConfigLabel" android:text="Target SDK" />
            <TextView android:id="@+id/tvTargetSdk" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Android 14 (API 34)" android:textColor="#FFFFFF" android:textSize="10sp" android:background="#1A1A1A" android:padding="6dp" android:layout_marginBottom="10dp" />

            <TextView style="@style/ConfigLabel" android:text="Build Variant" />
            <TextView android:id="@+id/tvBuildVariant" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="arm64-v8a" android:textColor="#FFFFFF" android:textSize="10sp" android:background="#1A1A1A" android:padding="6dp" android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Output"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <TextView style="@style/ConfigLabel" android:text="Output Path" />
            <TextView android:id="@+id/tvOutputPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="/Android/data/com.aalamstudio.compiler" android:textColor="#888888" android:textSize="9sp" android:layout_marginBottom="8dp" />

            <TextView style="@style/ConfigLabel" android:text="File Name" />
            <TextView android:id="@+id/tvFileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="aalam-compiler-output.apk" android:textColor="#888888" android:textSize="9sp" android:layout_marginBottom="8dp" />

            <TextView style="@style/ConfigLabel" android:text="Expected Size" />
            <TextView android:id="@+id/tvExpectedSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="-- MB" android:textColor="#888888" android:textSize="9sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
